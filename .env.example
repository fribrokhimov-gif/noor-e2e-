# Copy to .env and fill in. Never commit .env.

# Merchant panel (system under test)
BASE_URL=https://tmerchant.noor.uz

# Backend hosts (used for network assertions and test-data provisioning)
CORE_API_URL=https://core.test.api.noor.uz
EMPLOYEES_API_URL=https://eats.test.api.noor.uz/api/v1
X_PLATFORM=web

# Merchant account under test
MERCHANT_PHONE=+998XXXXXXXXX
MERCHANT_PASSWORD=

# Forgot-password E2E: the hardcoded OTP for the virtual +99800XXXXXXX test numbers.
# The test provisions a disposable account, resets its password through the UI, then cleans up.
RESET_OTP=
